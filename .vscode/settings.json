{
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        ".direnv/**": true
    },
    "editor.inlayHints.enabled": "offUnlessPressed",
    "emmylua.ls.executablePath": "emmylua_ls",
    "emmylua.semanticTokens.renderDocumentationMarkup": true,
    "[lua]": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "editor.wordBasedSuggestions": "off",
        "editor.inlineSuggest.enabled": false,
        "editor.defaultFormatter": "tangzx.emmylua"
    },
    "files.associations": {
        "*.cfg": "plaintext"
    },
    "python.analysis.typeCheckingMode": "standard",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.lua": "${capture}-updates.lua, ${capture}-final-fixes.lua",
        ".envrc": "flake.nix, flake.lock",
        "info.json": "changelog.txt, thumbnail.png",
        "README.md": "LICENSE",
        ".gitignore": ".gitattributes",
    },
    "explorer.sortOrder": "mixed"
}